<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    Onglet Utilisateurs — BCD Express
    Design moderne conforme à la maquette de référence :
    - En-tête : Titre + Ajouter un utilisateur & Importer CSV
    - Barre de recherche + Filtre de classe
    - Vue Partagée :
        * Gauche : 3 Cartes KPI (Élèves, Enseignants, Classes) + Tableau avec avatars initiaux
        * Droite : Fiche élève complète (Avatar, Détails, Prêts en cours, Historique récent, Modifier/Supprimer)
-->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="fr.ecole.bcd.controller.UtilisateursController"
      spacing="16" styleClass="tab-content">

    <!-- ── 1. En-tête : Titre & Actions principales ─────────────────────── -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Utilisateurs &amp; Élèves" styleClass="screen-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnPassageAnnee" text="🎓 Rentrée scolaire &amp; Import ONDE" styleClass="btn-outline"
                onAction="#handleOpenPassageAnneeDialog"/>
        <Button fx:id="btnImportCsv" text="📥 Importer CSV" styleClass="btn-outline"
                onAction="#handleImportCsv"/>
        <Button fx:id="btnAdd" text="➕ Ajouter un utilisateur" styleClass="btn-blue"
                onAction="#handleAdd"/>
    </HBox>

    <!-- ── 2. Recherche par nom, prénom ou numéro + Filtre classe ─────── -->
    <HBox spacing="14" alignment="CENTER_LEFT" styleClass="mockup-card">
        <TextField fx:id="searchField"
                   promptText="🔍 Rechercher par nom, prénom ou numéro (ex: EL-042)…"
                   prefWidth="380" HBox.hgrow="ALWAYS"/>
        <Label text="Classe" styleClass="filter-label"/>
        <ComboBox fx:id="classeFilter" promptText="Toutes les classes" prefWidth="170"/>
    </HBox>

    <!-- ── 3. Vue Partagée : KPIs + Tableau (Gauche) | Fiche Élève (Droite) ─ -->
    <SplitPane dividerPositions="0.65" VBox.vgrow="ALWAYS">

        <!-- Colonne Gauche : KPIs & Tableau -->
        <VBox spacing="14">
            <!-- 3 Cartes KPI (Élèves, Enseignants, Classes) -->
            <HBox spacing="12">
                <!-- Élèves -->
                <HBox spacing="12" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="kpi-card">
                    <Label text="👧" styleClass="kpi-icon-box-emerald"/>
                    <VBox spacing="2">
                        <Label text="Élèves" styleClass="kpi-title"/>
                        <Label fx:id="lblKpiEleves" text="0" styleClass="kpi-value"/>
                    </VBox>
                </HBox>

                <!-- Enseignants -->
                <HBox spacing="12" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="kpi-card">
                    <Label text="👩‍🏫" styleClass="kpi-icon-box-blue"/>
                    <VBox spacing="2">
                        <Label text="Enseignants" styleClass="kpi-title"/>
                        <Label fx:id="lblKpiEnseignants" text="0" styleClass="kpi-value"/>
                    </VBox>
                </HBox>

                <!-- Classes -->
                <HBox spacing="12" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="kpi-card">
                    <Label text="🏫" styleClass="kpi-icon-box-purple"/>
                    <VBox spacing="2">
                        <Label text="Classes" styleClass="kpi-title"/>
                        <Label fx:id="lblKpiClasses" text="0" styleClass="kpi-value"/>
                    </VBox>
                </HBox>
            </HBox>

            <!-- Tableau des utilisateurs -->
            <TableView fx:id="tableView" VBox.vgrow="ALWAYS" minHeight="240">
                <columns>
                    <TableColumn fx:id="colNumero" text="NUMÉRO" prefWidth="95"/>
                    <TableColumn fx:id="colNom" text="NOM &amp; PRÉNOM" prefWidth="250"/>
                    <TableColumn fx:id="colClasse" text="CLASSE" prefWidth="105"/>
                    <TableColumn fx:id="colType" text="TYPE" prefWidth="120"/>
                </columns>
                <placeholder>
                    <Label text="Aucun utilisateur trouvé." style="-fx-text-fill: #94A3B8; -fx-font-size: 13px;"/>
                </placeholder>
            </TableView>

            <!-- Barre de statut inférieure -->
            <HBox alignment="CENTER_LEFT" styleClass="status-bar">
                <Label fx:id="statusLabel" text="Chargement…"/>
            </HBox>
        </VBox>

        <!-- Colonne Droite : Fiche Élève / Utilisateur -->
        <StackPane fx:id="userDetailContainer" minWidth="340">

            <!-- Message vide si aucun utilisateur sélectionné -->
            <VBox fx:id="emptyUserDetailBox" alignment="CENTER" spacing="12" styleClass="detail-card">
                <Label text="👤" style="-fx-font-size: 38px;"/>
                <Label text="Sélectionnez un utilisateur"
                       style="-fx-font-weight: 700; -fx-font-size: 15px;"/>
                <Label text="pour voir sa fiche détaillée, sa carte et ses emprunts en cours."
                       textAlignment="CENTER" wrapText="true"
                       style="-fx-font-size: 12px; -fx-max-width: 240px;"/>
            </VBox>

            <!-- Fiche détaillée active -->
            <VBox fx:id="userDetailCard" spacing="14" styleClass="detail-card" visible="false">

                <!-- En-tête fiche : Titre + Boutons Modifier/Supprimer -->
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="user-detail-header-bar">
                    <Label text="Fiche élève" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnEdit" text="✏️ Modifier" styleClass="btn-outline, btn-sm"
                            onAction="#handleEdit"/>
                    <Button fx:id="btnDelete" text="🗑️ Supprimer" styleClass="btn-danger-outline, btn-sm"
                            onAction="#handleDelete"/>
                </HBox>

                <!-- Avatar & Nom -->
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label fx:id="userDetailAvatar" text="LM"
                           style="-fx-background-color: #1A66FF; -fx-text-fill: white; -fx-font-weight: 800; -fx-font-size: 16px; -fx-min-width: 48px; -fx-pref-width: 48px; -fx-min-height: 48px; -fx-pref-height: 48px; -fx-background-radius: 999px; -fx-alignment: center;"/>
                    <VBox spacing="2">
                        <Label fx:id="userDetailName" text="Nom Prénom"
                               style="-fx-font-weight: 800; -fx-font-size: 16px;"/>
                        <Label fx:id="userDetailSub" text="Classe • Carte n°..."
                               style="-fx-font-weight: 600; -fx-font-size: 12px;"/>
                    </VBox>
                </HBox>

                <!-- Grille d'informations -->
                <VBox spacing="8" styleClass="user-info-box">
                    <Label text="INFORMATIONS" style="-fx-font-size: 10.5px; -fx-font-weight: 800;" styleClass="detail-meta"/>

                    <HBox alignment="CENTER_LEFT">
                        <Label text="Numéro identifiant" styleClass="detail-meta"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="userDetailNum" text="–"
                               style="-fx-font-family: monospace; -fx-font-weight: bold;"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT">
                        <Label text="Classe" styleClass="detail-meta"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="userDetailClass" text="–"
                               style="-fx-font-weight: 700;"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT">
                        <Label text="Type" styleClass="detail-meta"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="userDetailType" text="–"
                               style="-fx-font-weight: 600;"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT">
                        <Label text="Prêts en cours" styleClass="detail-meta"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="userDetailLoans" text="0"
                               style="-fx-font-weight: 800; -fx-font-size: 13px; -fx-text-fill: #1A66FF;"/>
                    </HBox>
                </VBox>

                <!-- Section Derniers emprunts -->
                <VBox spacing="8" VBox.vgrow="ALWAYS">
                    <Label text="Emprunts en cours" styleClass="card-title"/>
                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                                style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;">
                        <VBox fx:id="userDetailRecentLoans" spacing="6"/>
                    </ScrollPane>
                </VBox>

            </VBox>

        </StackPane>

    </SplitPane>

</VBox>
