<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    Onglet Récolement & Inventaire physique — BCD Express
    Gestion professionnelle inspirée du retail / Max Mara :
    - Campagne d'inventaire ciblée (Tout, 1 Genre, 1 Thème, 1 Niveau, ou 1 Livre précis)
    - Gel automatique des mouvements (Stock Freeze) pendant la session
    - Pointage douchette & Qualification des écarts (+/-)
    - Clôture avec Procès-Verbal officiel pour l'école
-->
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="fr.ecole.bcd.controller.RecolementController">

    <!-- ── Contenu Principal ── -->
    <VBox spacing="16" styleClass="tab-content">

        <!-- ── 1. En-tête : Titre & Actions principales ─────────────────────── -->
        <HBox spacing="14" alignment="CENTER_LEFT">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Récolement &amp; Inventaire" styleClass="screen-title"/>
                <Label text="Campagnes d'inventaire avec gel de stock temporaire, pointage douchette et qualification des écarts."
                       style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>
            </VBox>

            <!-- Actions de Session -->
            <Button text="🔄 Actualiser" styleClass="btn-outline"
                    onAction="#loadData"/>
            <Button fx:id="btnStartCampaign" text="🚀 Démarrer un inventaire" styleClass="btn-blue"
                    onAction="#handleStartCampaign"/>
            <Button fx:id="btnCloturerSession" text="✅ Valider &amp; Clôturer l'inventaire"
                    style="-fx-background-color: #16A34A; -fx-text-fill: white; -fx-font-weight: 700; -fx-background-radius: 10px; -fx-padding: 9px 16px; -fx-cursor: hand;"
                    onAction="#handleCloturerSession" visible="false" managed="false"/>
            <Button fx:id="btnAnnulerSession" text="✕ Abandonner la session" styleClass="btn-danger-outline"
                    onAction="#handleAnnulerSession" visible="false" managed="false"/>
            <Button fx:id="btnExportCsv" text="📤 Exporter CSV" styleClass="btn-outline"
                    onAction="#handleExportCsv"/>
        </HBox>

        <!-- ── 2. Bandeau d'état de la Session (Gel de stock actif / inactif) ── -->
        <HBox fx:id="sessionBanner" spacing="14" alignment="CENTER_LEFT" styleClass="session-banner">
            <Label fx:id="lblSessionBadge" text="🟢 Mode Veille" styleClass="pill-green"/>
            <Label fx:id="lblSessionDetails" text="Aucune session active — Les mouvements de prêt/retour fonctionnent normalement sur toute la BCD."
                   HBox.hgrow="ALWAYS" styleClass="session-details-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblFreezeWarning" text="🧊 Prêts autorisés" styleClass="session-freeze-text"/>
        </HBox>

        <!-- ── 3. Cartes KPIs (4 Colonnes comme sur la maquette) ───────────── -->
        <HBox spacing="14">
            <!-- Total Exemplaires -->
            <HBox spacing="14" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="kpi-card">
                <Label text="📚" styleClass="kpi-icon-box-blue"/>
                <VBox spacing="2">
                    <Label text="Périmètre suivi" styleClass="kpi-title"/>
                    <Label fx:id="lblTotalCount" text="0" styleClass="kpi-value"/>
                </VBox>
            </HBox>

            <!-- Présents scannés -->
            <HBox spacing="14" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="kpi-card">
                <Label text="✅" styleClass="kpi-icon-box-emerald"/>
                <VBox spacing="2">
                    <Label text="Présents scannés" styleClass="kpi-title"/>
                    <Label fx:id="lblPresentCount" text="0 (0%)" styleClass="kpi-value" style="-fx-text-fill: #15803D;"/>
                </VBox>
            </HBox>

            <!-- En prêt -->
            <HBox spacing="14" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="kpi-card">
                <Label text="👤" styleClass="kpi-icon-box-blue"/>
                <VBox spacing="2">
                    <Label text="En prêt (Justifiés)" styleClass="kpi-title"/>
                    <Label fx:id="lblPretCount" text="0 (0%)" styleClass="kpi-value" style="-fx-text-fill: #1A66FF;"/>
                </VBox>
            </HBox>

            <!-- À vérifier / Manquants -->
            <HBox spacing="14" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="kpi-card">
                <Label text="⚠️" styleClass="kpi-icon-box-orange"/>
                <VBox spacing="2">
                    <Label text="Écarts / Manquants" styleClass="kpi-title"/>
                    <Label fx:id="lblManquantCount" text="0 (0%)" styleClass="kpi-value" style="-fx-text-fill: #EA580C;"/>
                </VBox>
            </HBox>
        </HBox>

        <!-- ── 4. Progression (Gauche) + Scanner douchette étagère (Droite) ─── -->
        <HBox spacing="14" alignment="CENTER_LEFT">
            <!-- Carte Progression -->
            <VBox spacing="10" prefWidth="420" styleClass="mockup-card">
                <Label text="Progression de la campagne" styleClass="card-title"/>
                <ProgressBar fx:id="progressBar" maxWidth="Infinity" prefHeight="12" progress="0"/>
                <Label fx:id="lblProgressPercent" text="0% (0 / 0 vérifiés)"
                       style="-fx-font-size: 11.5px; -fx-text-fill: #1A66FF; -fx-font-weight: 700;"/>
            </VBox>

            <!-- Carte Scan Douchette -->
            <VBox spacing="8" HBox.hgrow="ALWAYS" styleClass="mockup-card-accent">
                <Label text="⚡ Scanner un exemplaire sur l'étagère" styleClass="card-title"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="scanField"
                               promptText="Code-barres ISBN au dos ou N° physique d'exemplaire (ex: #165)…"
                               HBox.hgrow="ALWAYS" onAction="#handleScanSubmit"/>
                    <Button fx:id="btnScanValidate" text="Scanner" styleClass="btn-blue"
                            onAction="#handleScanSubmit"/>
                </HBox>
                <Label fx:id="lblFeedback" text="💡 Positionnez la douchette sur les livres des étagères du périmètre."
                       style="-fx-font-size: 11.5px; -fx-text-fill: #1A66FF; -fx-font-weight: 600;"/>
            </VBox>
        </HBox>

        <!-- ── 5. Filtres de liste & Recherche ──────────────────────────────── -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <ToggleButton fx:id="tbManquants" text="À vérifier / Manquants" onAction="#handleFilterChange"/>
            <ToggleButton fx:id="tbPresents" text="Présents" onAction="#handleFilterChange"/>
            <ToggleButton fx:id="tbPrets" text="En prêt" onAction="#handleFilterChange"/>
            <ToggleButton fx:id="tbSurplus" text="Surplus" onAction="#handleFilterChange"/>
            <ToggleButton fx:id="tbTous" text="Tous" onAction="#handleFilterChange"/>

            <Region HBox.hgrow="ALWAYS"/>

            <TextField fx:id="tableSearchField" promptText="🔍 Filtrer le tableau…" prefWidth="180"/>
            <Button fx:id="btnCopierIsbn" text="📋 Copier l'ISBN" styleClass="btn-outline"
                    onAction="#handleCopierIsbn"/>
            <Button fx:id="btnPointerDirect" text="✅ Pointer présent" styleClass="btn-blue"
                    onAction="#handlePointerDirect"/>
            <Button fx:id="btnQualifierEcart" text="✏️ Justifier l'écart (+/-)" styleClass="btn-outline"
                    onAction="#handleQualifierEcart"/>
        </HBox>

        <!-- ── 6. Tableau des exemplaires du récolement ─────────────────────── -->
        <TableView fx:id="recolementTable" VBox.vgrow="ALWAYS" minHeight="240">
            <columns>
                <TableColumn fx:id="colId" text="EXEMPLAIRE" prefWidth="95"/>
                <TableColumn fx:id="colTitre" text="LIVRE (TITRE &amp; AUTEUR)" prefWidth="260"/>
                <TableColumn fx:id="colIsbn" text="ISBN" prefWidth="120"/>
                <TableColumn fx:id="colStatut" text="STATUT" prefWidth="115"/>
                <TableColumn fx:id="colMotifEcart" text="MOTIF D'ÉCART (+ / -)" prefWidth="200"/>
                <TableColumn fx:id="colInfo" text="SITUATION / EMPRUNTEUR / SCAN" prefWidth="220"/>
                <TableColumn fx:id="colRemarque" text="REMARQUE &amp; ÉTAT" prefWidth="130"/>
            </columns>
            <placeholder>
                <Label text="Aucun exemplaire dans cette vue." style="-fx-text-fill: #94A3B8; -fx-font-size: 13px;"/>
            </placeholder>
        </TableView>

    </VBox>

    <!-- ── 7. Modale In-App pour choix du périmètre et validation (Évite tout écran noir en plein écran macOS) ── -->
    <StackPane fx:id="modalOverlay" visible="false" managed="false" alignment="CENTER"
               style="-fx-background-color: rgba(15, 23, 42, 0.45); -fx-background-radius: 0;">
        <VBox fx:id="modalCard" maxWidth="560" spacing="16" styleClass="mockup-card, modal-card-inapp">
            <!-- Contenu dynamique injecté par RecolementController -->
        </VBox>
    </StackPane>

</StackPane>
