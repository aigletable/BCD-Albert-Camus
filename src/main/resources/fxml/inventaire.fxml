<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<!--
    Onglet Inventaire & Livres — BCD Express
    Design 100% fidèle à la maquette de référence :
    - En-tête : Titre + Ajouter un livre + Importer + Menu déroulant "Plus v"
    - Barre de recherche + 3 Filtres déroulants + Bouton Réinitialiser + Switch Grille / Liste
    - Vue Partagée :
        * Gauche : Grille moderne de cartes (avec couvertures, badges de statut, exemplaires et cycles)
                   ou vue Liste tabulaire complète au choix via le switcher
        * Droite : Fiche complète détaillée avec prévisualisation, recherche de couverture,
                   boutons Modifier / Supprimer, grille de métadonnées et gestion des exemplaires physiques
-->
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="fr.ecole.bcd.controller.InventaireController">

    <!-- ── Contenu Principal de l'Inventaire ── -->
    <VBox spacing="16" styleClass="tab-content">

    <!-- ── 1. En-tête : Titre & Actions principales (Comme sur la maquette) ── -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Inventaire &amp; Livres" styleClass="screen-title"/>
        <Region HBox.hgrow="ALWAYS"/>

        <Button fx:id="btnModeDouchetteTop" text="⚡ Mode Douchette (Ajout rapide)"
                style="-fx-background-color: #6366F1; -fx-text-fill: white; -fx-font-weight: 700; -fx-cursor: hand; -fx-background-radius: 6; -fx-padding: 7 14;"
                onAction="#handleModeDouchette"/>
        <Button fx:id="btnAddLivre" text="➕ Ajouter un livre" styleClass="btn-blue"
                onAction="#handleAddLivre"/>
        <Button fx:id="btnAddByTitle" text="📖 Sans code-barres" styleClass="btn-outline"
                onAction="#handleAddByTitle"/>
        <Button fx:id="btnImportCsv" text="📥 Importer CSV" styleClass="btn-outline"
                onAction="#handleImportCsv"/>

        <!-- Menu déroulant "Outils v" regroupant les fonctions secondaires -->
        <MenuButton text="Outils ▾" styleClass="btn-outline">
            <items>
                <MenuItem text="📦 Boîte à vérifier &amp; anomalies" onAction="#handleOpenBoiteVerification"/>
                <MenuItem text="🪄 Classifier le catalogue automatiquement" onAction="#handleClassifyCatalogue"/>
                <MenuItem text="🖼️ Rafraîchir les couvertures" onAction="#handleRefreshAllCovers"/>
                <SeparatorMenuItem/>
                <MenuItem text="📤 Exporter le catalogue (CSV)" onAction="#handleExportCatalogue"/>
            </items>
        </MenuButton>
    </HBox>

    <!-- ── 2. Barre de Recherche & Filtres Déroulants (Design Responsive & Spacieux) ──── -->
    <VBox spacing="10" styleClass="mockup-card" style="-fx-padding: 12px 14px;">
        <!-- Ligne 1 : Barre de Recherche principale + Switcher Grille / Liste -->
        <HBox spacing="12" alignment="CENTER_LEFT">
            <TextField fx:id="searchField"
                       promptText="🔍 Rechercher un livre, un auteur, un ISBN, un genre, un niveau…"
                       HBox.hgrow="ALWAYS"
                       style="-fx-font-size: 13px; -fx-padding: 7px 12px;"/>

            <!-- Switcher Grille / Liste fidèle à la maquette -->
            <HBox alignment="CENTER" spacing="2" styleClass="view-switcher-box">
                <Button fx:id="btnViewGrid" text="⊞ Grille" onAction="#setViewGrid"
                        styleClass="btn-view-toggle, btn-view-active"/>
                <Button fx:id="btnViewList" text="☰ Liste" onAction="#setViewList"
                        styleClass="btn-view-toggle, btn-view-inactive"/>
            </HBox>
        </HBox>

        <!-- Ligne 2 : Filtres Genre, Thème, Niveau & Réinitialisation (Largeur confortable & jamais tronqués) -->
        <HBox spacing="14" alignment="CENTER_LEFT">
            <!-- Filtre Genre -->
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="Genre :" minWidth="-Infinity"
                       style="-fx-font-size: 11.5px; -fx-font-weight: 600; -fx-text-fill: #64748B;"/>
                <ComboBox fx:id="genreFilter" promptText="Tous les genres" minWidth="140" prefWidth="160"/>
            </HBox>

            <!-- Filtre Thème -->
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="Thème :" minWidth="-Infinity"
                       style="-fx-font-size: 11.5px; -fx-font-weight: 600; -fx-text-fill: #64748B;"/>
                <ComboBox fx:id="themeFilter" promptText="Tous les thèmes" minWidth="160" prefWidth="210"/>
            </HBox>

            <!-- Filtre Niveau -->
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="Niveau :" minWidth="-Infinity"
                       style="-fx-font-size: 11.5px; -fx-font-weight: 600; -fx-text-fill: #64748B;"/>
                <ComboBox fx:id="niveauFilter" promptText="Tous les niveaux" minWidth="150" prefWidth="180"/>
            </HBox>

            <!-- Filtre rapide Livres à 0 exemplaire -->
            <ToggleButton fx:id="btnFilterZeroCopies" text="⚠️ 0 exemplaire"
                          styleClass="btn-outline" minWidth="-Infinity"
                          style="-fx-font-size: 11.5px; -fx-padding: 5px 12px; -fx-cursor: hand;"
                          onAction="#handleToggleFilterZeroCopies"/>

            <!-- Bouton Réinitialiser avec libellé explicite -->
            <Button fx:id="btnResetFilters" text="🔄 Réinitialiser" styleClass="btn-outline"
                    minWidth="-Infinity"
                    style="-fx-font-size: 11.5px; -fx-padding: 5px 12px;"
                    onAction="#handleResetFilters"/>
        </HBox>
    </VBox>

    <!-- ── 3. Vue Partagée : Catalogue (Gauche 60%) + Fiche complète (Droite 40%) ─ -->
    <SplitPane fx:id="splitPane" dividerPositions="0.60" VBox.vgrow="ALWAYS">

        <!-- Colonne Gauche : Catalogue (Cartes en mode Grille ou Tableau en mode Liste) -->
        <VBox spacing="10">
            <TableView fx:id="livreTableView" VBox.vgrow="ALWAYS" minHeight="240">
                <columns>
                    <TableColumn fx:id="colCard" text="CATALOGUE DES LIVRES" prefWidth="560"/>
                    <!-- Colonnes pour le mode Liste tabulaire -->
                    <TableColumn fx:id="colTitre" text="TITRE" prefWidth="220"/>
                    <TableColumn fx:id="colAuteur" text="AUTEUR" prefWidth="140"/>
                    <TableColumn fx:id="colGenre" text="GENRE" prefWidth="95"/>
                    <TableColumn fx:id="colNiveau" text="NIVEAU" prefWidth="90"/>
                    <TableColumn fx:id="colTheme" text="THÈME" prefWidth="130"/>
                    <TableColumn fx:id="colEditeur" text="ÉDITEUR" prefWidth="110"/>
                    <TableColumn fx:id="colIsbn" text="ISBN" prefWidth="115"/>
                    <TableColumn fx:id="colExemplaires" text="EXEMPLAIRES" prefWidth="105"/>
                </columns>
                <placeholder>
                    <Label text="Aucun livre trouvé dans le catalogue." style="-fx-text-fill: #94A3B8; -fx-font-size: 13px;"/>
                </placeholder>
            </TableView>

            <!-- Barre d'actions groupées (visible dès que plusieurs livres sont sélectionnés) -->
            <HBox fx:id="boxBatchActions" alignment="CENTER_LEFT" spacing="12"
                  style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 14;"
                  visible="false" managed="false">
                <Label fx:id="lblBatchCount" text="☑️ 0 livres sélectionnés"
                       style="-fx-font-weight: 700; -fx-font-size: 12px; -fx-text-fill: #1E293B;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnBatchLabels" text="🏷️ Étiquettes de la sélection" styleClass="btn-outline, btn-sm"
                        onAction="#handleBatchLabels"/>
                <Button fx:id="btnBatchDelete" text="🗑️ Supprimer la sélection" styleClass="btn-danger-outline, btn-sm"
                        style="-fx-text-fill: #DC2626; -fx-border-color: #DC2626; -fx-font-weight: bold;"
                        onAction="#handleDeleteLivre"/>
                <Button text="✕" styleClass="btn-outline, btn-sm" onAction="#handleClearSelection"
                        style="-fx-cursor: hand;"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" styleClass="status-bar">
                <Label fx:id="statusLabel" text="Chargement du catalogue…"/>
            </HBox>
        </VBox>

        <!-- Colonne Droite : Fiche détaillée du livre & Exemplaires physiques -->
        <StackPane fx:id="detailContainer" minWidth="370">

            <!-- Placeholder quand aucun livre n'est sélectionné -->
            <VBox fx:id="emptyDetailBox" alignment="CENTER" spacing="12" styleClass="detail-card">
                <Label text="📖" style="-fx-font-size: 40px;"/>
                <Label text="Sélectionnez un livre"
                       style="-fx-font-weight: 700; -fx-font-size: 15px;"/>
                <Label text="pour afficher sa fiche complète, ses métadonnées et gérer ses exemplaires physiques."
                       textAlignment="CENTER" wrapText="true"
                       style="-fx-text-fill: #8B949E; -fx-font-size: 12px; -fx-max-width: 260px;"/>
            </VBox>

            <!-- Fiche détaillée active conforme à la maquette -->
            <VBox fx:id="detailContentBox" spacing="14" styleClass="detail-card" visible="false">

                <!-- En-tête : Couverture + Métadonnées + Boutons Modifier/Supprimer -->
                <HBox spacing="14" alignment="TOP_LEFT">
                    <!-- Boîte couverture -->
                    <VBox spacing="6" alignment="CENTER">
                        <StackPane fx:id="coverBox" styleClass="cover-box"
                                   minWidth="88" maxWidth="88" minHeight="120" maxHeight="120">
                            <ImageView fx:id="imgCouverture" fitWidth="88" fitHeight="120" preserveRatio="true"/>
                            <Label fx:id="lblNoCover" text="📖" style="-fx-font-size: 32px;" visible="false"/>
                            <ProgressIndicator fx:id="coverProgress" maxWidth="24" maxHeight="24" visible="false"/>
                        </StackPane>
                        <Button fx:id="btnSearchCover" text="🔍 Couverture..." styleClass="btn-outline, btn-sm"
                                onAction="#handleSearchCover"/>
                    </VBox>

                    <!-- Infos Titre, Auteur, Actions et Métadonnées -->
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <HBox alignment="TOP_LEFT" spacing="6">
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label fx:id="lblTitre" styleClass="detail-title" wrapText="true"/>
                                <Label fx:id="lblAuteur" styleClass="detail-subtitle" wrapText="true"/>
                            </VBox>
                            <!-- Boutons Modifier / Supprimer sur la fiche -->
                            <HBox spacing="4" alignment="TOP_RIGHT">
                                <Button fx:id="btnEditLivre" text="✏️ Modifier" styleClass="btn-outline, btn-sm"
                                        onAction="#handleEditLivre"/>
                                <Button fx:id="btnDeleteLivre" text="🗑️" styleClass="btn-danger-outline, btn-sm"
                                        onAction="#handleDeleteLivre"/>
                            </HBox>
                        </HBox>

                        <!-- Grille de métadonnées alignée comme sur la maquette -->
                        <VBox spacing="6" styleClass="detail-divider-box">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Genre" style="-fx-text-fill: #8B949E; -fx-font-size: 11.5px; -fx-font-weight: 500;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="lblBadgeGenre" styleClass="badge-genre" text="Roman"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Thème" style="-fx-text-fill: #8B949E; -fx-font-size: 11.5px; -fx-font-weight: 500;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="lblBadgeTheme" styleClass="badge-theme" text="Aventure"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Niveau" style="-fx-text-fill: #8B949E; -fx-font-size: 11.5px; -fx-font-weight: 500;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="lblBadgeNiveau" styleClass="badge-niveau" text="Cycle 2"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT">
                                <Label text="ISBN" style="-fx-text-fill: #8B949E; -fx-font-size: 11.5px; -fx-font-weight: 500;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="lblIsbn" style="-fx-font-family: monospace; -fx-font-weight: bold; -fx-font-size: 11.5px;"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Éditeur" style="-fx-text-fill: #8B949E; -fx-font-size: 11.5px; -fx-font-weight: 500;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="lblEditeur" style="-fx-font-weight: 600; -fx-font-size: 11.5px;"/>
                            </HBox>
                            <HBox fx:id="rowMalletteInfo" alignment="CENTER_LEFT" visible="false" managed="false">
                                <Label text="Mallette" style="-fx-text-fill: #8B949E; -fx-font-size: 11.5px; -fx-font-weight: 500;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="lblBadgeMallette" text="Mallette"
                                       style="-fx-background-color: #f3e8ff; -fx-text-fill: #7c3aed; -fx-padding: 2 6; -fx-background-radius: 6; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                            </HBox>
                        </VBox>

                        <!-- Accès direct aux Ressources Pédagogiques du livre -->
                        <Button fx:id="btnRessourcesLivre" text="📚 Ressources pédagogiques" styleClass="btn-outline, btn-sm"
                                onAction="#handleRessourcesLivre" maxWidth="Infinity" style="-fx-font-weight: 600; -fx-cursor: hand;"/>
                    </VBox>
                </HBox>

                <Separator/>

                <!-- Section des exemplaires physiques -->
                <VBox spacing="8" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="📦 Exemplaires physiques"
                               style="-fx-font-weight: 800; -fx-font-size: 12.5px;"/>
                        <Label fx:id="lblExemplairesRatio" text="1/1 dispo" styleClass="pill-green"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnAddExemplaire" text="➕ Exemplaire" styleClass="btn-blue, btn-sm"
                                onAction="#handleAddExemplaire"/>
                        <Button fx:id="btnReassignExemplaire" text="🔀 Séparer…" styleClass="btn-outline, btn-sm"
                                onAction="#handleReassignExemplaire"/>
                        <Button fx:id="btnEditExemplaire" text="⚠️ État" styleClass="btn-outline, btn-sm"
                                onAction="#handleEditExemplaireRemarque"/>
                        <Button fx:id="btnDeleteExemplaire" text="🗑️" styleClass="btn-danger-outline, btn-sm"
                                onAction="#handleDeleteExemplaire"/>
                    </HBox>

                    <!-- Tableau des exemplaires physiques -->
                    <TableView fx:id="exemplaireTableView" VBox.vgrow="ALWAYS" minHeight="140">
                        <columns>
                            <TableColumn fx:id="colExId" text="N° ID" prefWidth="65"/>
                            <TableColumn fx:id="colExStatut" text="STATUT" prefWidth="110"/>
                            <TableColumn fx:id="colExRemarque" text="ÉTAT / REMARQUE" prefWidth="125"/>
                            <TableColumn fx:id="colExDate" text="AJOUT" prefWidth="90"/>
                        </columns>
                        <placeholder>
                            <Label text="Aucun exemplaire physique." style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                        </placeholder>
                    </TableView>
                </VBox>

            </VBox>

        </StackPane>

    </SplitPane>

    </VBox>

    <!-- ── Calque Modal In-App (Overlay anti-écran noir pour plein écran) ── -->
    <StackPane fx:id="modalOverlay" visible="false" managed="false"
               style="-fx-background-color: rgba(15, 23, 42, 0.60); -fx-alignment: center;">
        <VBox fx:id="modalCard" maxWidth="720" maxHeight="620" spacing="14"
              styleClass="mockup-card, modal-card-inapp">
            <!-- Rempli dynamiquement par InventaireController -->
        </VBox>
    </StackPane>

</StackPane>
